{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env ROLES=api,scheduler,consumer tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.mjs",
    "start:prod": "npm run migrate && npm start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "event:replay": "tsx src/scripts/replay-event.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "cross-env ROLES=api tsx watch src/server.ts",
    "dev:scheduler": "cross-env ROLES=scheduler tsx watch src/server.ts",
    "dev:consumer": "cross-env ROLES=consumer tsx watch src/server.ts",
    "dev:notifier": "cross-env ROLES=notifier tsx watch src/server.ts",
    "test:integration": "node scripts/check-infra.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "node-pg-migrate": "^7.6.1",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.1.4"
  }
